{
  "name": "@answerline/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f ../../.env -- tsx watch src/index.ts",
    "eval": "dotenvx run -f ../../.env -- tsx src/cli.ts eval",
    "start": "dotenvx run -f ../../.env -- tsx src/index.ts",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@answerline/db": "workspace:*",
    "@answerline/llm": "workspace:*",
    "@answerline/shared": "workspace:*",
    "bullmq": "^6.4.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.3"
  }
}
