{
  "name": "@answerline/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ingestion": "./src/ingestion.ts",
    "./phone-numbers": "./src/phone-numbers.ts"
  },
  "scripts": {
    "dev": "dotenvx run -f ../../.env -- tsx watch src/index.ts",
    "eval": "dotenvx run -f ../../.env -- tsx src/cli.ts eval",
    "sip": "dotenvx run -f ../../.env -- tsx src/cli.ts sip",
    "start": "dotenvx run -f ../../.env -- tsx src/index.ts",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@answerline/db": "workspace:*",
    "@answerline/llm": "workspace:*",
    "@answerline/shared": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "bullmq": "^6.7.2",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^30.1.3",
    "livekit-server-sdk": "2.19.2",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24",
    "typescript": "^5.9.3"
  }
}
