{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "caller": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      },
      "expect": {
        "type": "object",
        "properties": {
          "judge": {
            "type": "string"
          },
          "max_wer": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mentions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "not_mentions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tool_args": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "tool_called": {
            "type": "string"
          }
        }
      },
      "mocks": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "name": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "caller",
      "expect",
      "name"
    ]
  },
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
