{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "aggregate": {
      "type": "object",
      "properties": {
        "avgLatencyMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "avgWer": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "costUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stageLatency": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "llmTotalMs": {
                  "type": "object",
                  "properties": {
                    "p50": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "p95": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "p50",
                    "p95"
                  ]
                },
                "llmTtftMs": {
                  "type": "object",
                  "properties": {
                    "p50": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "p95": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "p50",
                    "p95"
                  ]
                },
                "sttMs": {
                  "type": "object",
                  "properties": {
                    "p50": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "p95": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "p50",
                    "p95"
                  ]
                },
                "ttsTtfbMs": {
                  "type": "object",
                  "properties": {
                    "p50": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "p95": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "p50",
                    "p95"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "avgLatencyMs",
        "avgWer",
        "costUsd",
        "passed",
        "total"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseName": {
            "type": "string",
            "minLength": 1
          },
          "costUsd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "latencyMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "modelUsage": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quantity": {
                      "type": "number",
                      "minimum": 0
                    },
                    "stage": {
                      "type": "string",
                      "const": "stt"
                    },
                    "unit": {
                      "type": "string",
                      "const": "seconds"
                    }
                  },
                  "required": [
                    "model",
                    "provider",
                    "quantity",
                    "stage",
                    "unit"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "stage": {
                      "type": "string",
                      "const": "llm"
                    },
                    "unit": {
                      "type": "string",
                      "enum": [
                        "input_tokens",
                        "output_tokens",
                        "cached_input_tokens",
                        "cache_creation_tokens"
                      ]
                    }
                  },
                  "required": [
                    "model",
                    "provider",
                    "quantity",
                    "stage",
                    "unit"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "stage": {
                      "type": "string",
                      "const": "tts"
                    },
                    "unit": {
                      "type": "string",
                      "const": "characters"
                    }
                  },
                  "required": [
                    "model",
                    "provider",
                    "quantity",
                    "stage",
                    "unit"
                  ]
                }
              ]
            }
          },
          "passed": {
            "type": "boolean"
          },
          "stageLatency": {
            "type": "object",
            "properties": {
              "llmTotalMs": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "llmTtftMs": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "sttMs": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "ttsTtfbMs": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "transcript": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "caller",
                    "agent"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ]
            }
          },
          "wer": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "caseName",
          "costUsd",
          "failures",
          "latencyMs",
          "passed",
          "transcript",
          "wer"
        ]
      }
    }
  },
  "required": [
    "aggregate",
    "results"
  ]
}
