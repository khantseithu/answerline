{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "callerAudio": {
      "type": "object",
      "properties": {
        "noiseSnrDb": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "profile": {
          "default": "clean",
          "type": "string",
          "enum": [
            "clean",
            "phone"
          ]
        },
        "seed": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tts": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\/(?:[\\w.:-]+\\/)?[\\w.:-]+$"
        },
        "voice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "judgeModel": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\/(?:[\\w.:-]+\\/)?[\\w.:-]+$"
    },
    "liveTools": {
      "type": "boolean"
    },
    "mode": {
      "type": "string",
      "enum": [
        "text",
        "audio"
      ]
    },
    "modelOverride": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\/(?:[\\w.:-]+\\/)?[\\w.:-]+$"
    },
    "sttOverride": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\/(?:[\\w.:-]+\\/)?[\\w.:-]+$"
    },
    "suite": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "ttsOverride": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\/(?:[\\w.:-]+\\/)?[\\w.:-]+$"
    }
  },
  "required": [
    "agentId",
    "suite"
  ]
}
