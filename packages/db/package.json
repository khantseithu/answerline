{
  "name": "@answerline/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "admin:init": "dotenvx run -f ../../.env -- tsx src/admin-init.ts",
    "check": "drizzle-kit check",
    "generate": "dotenvx run -f ../../.env -- drizzle-kit generate",
    "migrate": "dotenvx run -f ../../.env -- tsx src/migrate.ts",
    "seed": "dotenvx run -f ../../.env -- tsx src/seed.ts",
    "studio": "dotenvx run -f ../../.env -- drizzle-kit studio",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@answerline/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@types/node": "^24",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
