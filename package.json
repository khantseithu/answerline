{
  "name": "answerline",
  "private": true,
  "scripts": {
    "agent:dev": "uv run --env-file .env answerline-agent dev",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @answerline/db generate",
    "db:migrate": "pnpm --filter @answerline/db migrate",
    "db:seed": "pnpm --filter @answerline/db seed",
    "db:studio": "pnpm --filter @answerline/db studio",
    "dev": "turbo run dev",
    "eval": "pnpm --filter @answerline/worker eval",
    "format": "ultracite fix",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d postgres redis livekit",
    "lint": "ultracite check",
    "prepare": "lefthook install",
    "py:lint": "uv run ruff check . && uv run ruff format --check .",
    "py:test": "uv run pytest",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "ultracite": "8.0.1"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  }
}
