{
  "name": "answerline",
  "private": true,
  "scripts": {
    "agent:dev": "dotenvx run -- uv run answerline-agent dev",
    "bootstrap": "bash scripts/bootstrap.sh",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @answerline/db generate",
    "db:migrate": "pnpm --filter @answerline/db migrate",
    "db:seed": "pnpm --filter @answerline/db seed",
    "db:studio": "pnpm --filter @answerline/db studio",
    "dev": "turbo run dev",
    "eval": "pnpm --filter @answerline/worker eval",
    "format": "ultracite fix",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d postgres redis livekit minio minio-init egress",
    "lint": "ultracite check",
    "prepare": "lefthook install",
    "py:lint": "uv run ruff check . && uv run ruff format --check .",
    "py:test": "uv run pytest",
    "test": "node --test scripts/*.test.mjs && turbo run test",
    "typecheck": "turbo run typecheck",
    "wt": "treehouse get",
    "wt:gc": "scripts/worktree-gc.sh",
    "wt:status": "treehouse status"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@dotenvx/dotenvx": "^2.38.2",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "ultracite": "8.0.1"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  }
}
