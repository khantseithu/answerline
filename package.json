{
  "name": "answerline",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "infra:up": "docker compose up -d postgres redis livekit",
    "infra:down": "docker compose down",
    "agent:dev": "uv run --env-file .env answerline-agent dev",
    "eval": "pnpm --filter @answerline/worker eval",
    "py:test": "uv run pytest",
    "py:lint": "uv run ruff check . && uv run ruff format --check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  }
}
